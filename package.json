{
  "name": "smarterrornotebook",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vue-tsc --build tsconfig.app.json && vite build",
    "build:analyze": "vite build --mode analyze",
    "dev": "vite",
    "force-build": "vite build",
    "format": "prettier --write \"src/**/*.{vue,ts,js,css}\" \"tests/**/*.{ts,js}\" \"*.{ts,json}\"",
    "format:all": "prettier --write .",
    "format:check": "prettier --check \"src/**/*.{vue,ts,js,css}\" \"tests/**/*.{ts,js}\" \"*.{ts,json}\"",
    "format:check:all": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "@lucide/vue": "^1.45.0",
    "@quasar/extras": "^2.0.4",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "~2.5.2",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "dom-to-image-more": "^3.10.2",
    "dompurify": "^3.4.15",
    "gsap": "^3.15.0",
    "highlight.js": "^11.12.0",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^4.2.1",
    "katex": "^0.18.7",
    "marked": "^18.0.13",
    "marked-highlight": "^2.2.4",
    "marked-katex-extension": "^5.1.12",
    "quasar": "^2.32.2",
    "tauri-plugin-share": "^2.0.4",
    "uuid": "^14.0.2",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@quasar/vite-plugin": "^2.0.2",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.5.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-vue": "^10.11.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.6",
    "prettier-plugin-packagejson": "^3.0.2",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass-embedded": "^1.104.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.0.0",
      "onFail": "download"
    }
  }
}
